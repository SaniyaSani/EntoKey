{
  "profile": "wholefly-foundation-100k-v0.7",
  "description": "Whole-fly DINOv3 baseline using BIOSCAN, iNaturalist, GBIF and DiSSCo. Anatomy segmentation is not required.",
  "total_images": 100000,
  "source_targets": {
    "iNaturalist": 30000,
    "BIOSCAN-5M": 30000,
    "GBIF": 25000,
    "DiSSCo": 15000
  },
  "sampling_rank": "hierarchical",
  "max_per_source_taxon": 5000,
  "seed": 42,
  "shard_size": 2000,
  "embedding": {
    "model": "facebook/dinov3-vits16-pretrain-lvd1689m",
    "image_size": 512,
    "tile_grid": 2,
    "include_whole": true,
    "batch_size": 2,
    "strategy": "whole_plus_tiles",
    "segmentation_required": false
  },
  "training": {
    "min_family": 50,
    "min_genus": 25,
    "min_species": 12,
    "species_label_quality": "A,B",
    "gate_quantile": 0.05,
    "gate_margin": 0.02
  },
  "evaluation": {
    "per_source": true,
    "bioscan_unseen": true,
    "confusion_tables": true
  },
  "optional_modules": {
    "anatomy": false,
    "wing": false,
    "head": false,
    "enable_only_after_error_analysis": true
  }
}
