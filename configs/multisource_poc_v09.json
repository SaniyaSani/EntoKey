{
  "profile": "taxalens-multisource-poc-v0.9",
  "target_families_file": "configs/target_diptera_families.json",
  "required_families": ["Muscidae", "Tachinidae"],
  "bioscan_family_topup": {
    "families": ["Muscidae", "Tachinidae"],
    "min_images_per_family": 1500,
    "max_per_taxon": 250
  },
  "total_images": 100000,
  "source_targets": {
    "BIOSCAN-5M": 30000,
    "iNaturalist": 30000,
    "GBIF": 25000,
    "DiSSCo": 15000
  },
  "sampling_rank": "hierarchical",
  "max_per_source_taxon": 5000,
  "seed": 42,
  "shard_size": 1000,
  "embedding": {
    "model": "facebook/dinov3-vitb16-pretrain-lvd1689m",
    "image_size": 512,
    "tile_grid": 1,
    "include_whole": true,
    "batch_size": 4,
    "strategy": "whole_image_only",
    "segmentation_required": false,
    "specimen_crop_required": false
  },
  "training": {
    "min_family": 50,
    "min_genus": 25,
    "min_species": 12,
    "species_label_quality": "A,B",
    "gate_quantile": 0.05,
    "gate_margin": 0.02
  },
  "evaluation": {
    "per_source": true,
    "top_k": [1, 5],
    "open_set": true,
    "bioscan_unseen": true
  },
  "key_finder": {
    "automatic_after_genus_candidates": true,
    "candidate_genera": 4,
    "region": "Europe",
    "providers": ["curated", "Crossref", "OpenAlex"]
  }
}
